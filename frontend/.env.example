# Copy to .env.local to override. Both files matching .env.* are git-ignored, which is why
# the default below also lives in src/config.ts: a fresh clone must work with no .env at all.
#
# The api-gateway, and ONLY the gateway. The frontend never calls auth-service (8081),
# event-service (8082) or booking-service (8083) directly: those ports take X-User-Id on
# trust, and the gateway is what replaces a client's claimed identity with a proven one.
VITE_API_BASE_URL=http://localhost:8080
